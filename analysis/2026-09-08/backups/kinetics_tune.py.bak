#!/usr/bin/env python3
"""Search for a better MCKineticsObserver covariance tuning.

The search improves on a plain sweep in four ways:

0. **Velocity is optimised, not just checked.** Alongside the three relative pose metrics the
   objective carries the error of the observer's *estimated* local linear velocity -- its own
   velocity state, not a finite difference of its position -- evaluated in the frame each
   project's `Body_vel_eval` selects. A tuning cannot buy pose accuracy by becoming sluggish.
1. **Scalar objective in log-ratio space.** Every case is scored as ln(Kinetics / RI-EKF),
   so a 2x regression and a 2x improvement weigh the same, and a diverged trial stays
   finite instead of swamping the ranking. A soft-max term keeps the worst case in view
   without letting it dictate the whole objective.
2. **Model-based proposals.** Optuna's TPE learns which regions of the space are promising
   from every finished trial, instead of sweeping one coordinate at a time.
3. **Two-stage screening.** Phase A scores candidates on a cheap five-dataset subset
   (~26% of the cost); only the best are promoted to the full twelve in phase B. That buys
   roughly four times more exploration for the same wall clock.
4. **Parallel trials.** Replays are deterministic and independent, so trials run
   concurrently, each pinned to its own ROS_DOMAIN_ID to keep the DDS graphs apart.

The search space is anchored on the configuration currently installed in mc_rtc and spans a
few decades either side of it, split along axes where the physics differs (contact normal vs
tangential, contact yaw vs roll/pitch).
"""

import argparse
import atexit
import collections
import csv
import json
import math
import os
import re
import shutil
import signal
import subprocess
import sys
import threading
import time
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

import yaml

from kinetics_eval import (DEFAULT_MCKINETICS_CONFIG, PROJECTS, ROOT, observer_robot,
                           project_paths, project_robot)

SEED = 20260827
# Relative-pose metrics read from rpg. The translation error is split: `trans_xy` is the
# horizontal norm, `trans_z` the vertical component. They are kept apart because they answer to
# different parts of the model -- horizontal drift is odometry, vertical drift is the contact
# height bookkeeping that makes both filters climb over a long walk -- and because the goal
# states different requirements for them.
POSE_METRICS = ("trans_xy", "trans_z", "yaw", "tilt")
# Velocity is likewise split into its horizontal and vertical parts.
VELOCITY_METRICS = ("vel_xy", "vel_z")
METRICS = (*POSE_METRICS, *VELOCITY_METRICS)

# What the tuning is actually asked to achieve. HARD metrics must come out below RI-EKF: they
# carry the full log-ratio plus an extra penalty for any regression, so the search keeps paying
# to push them down. SOFT metrics only have to stay close: they score zero anywhere at or under
# SOFT_TOLERANCE x RI-EKF and are penalised only beyond it, so no search budget is spent
# improving them past "as good as the baseline" and none of them can be traded away either.
# Horizontal and vertical translation are scored separately and both are pushed as hard as they
# will go -- they answer to different physics (in-plane odometry vs contact-height bookkeeping),
# so there is nothing to gain from optimising their combined norm. Velocity joins them: at ~1.3x
# the baseline it is the worst channel, and it has to be corrected rather than merely contained.
# Yaw and tilt are already at or ahead of the baseline and stay hard so the regression penalty
# protects them: "keep them good" is a requirement, not a licence to trade them away.
# What the tuning is for, in the user's terms: beat the RI-EKF on most metrics; beat it *by far*
# on horizontal translation and yaw; and degrade less than it does when the feet slip.
#
# Weights make that priority explicit instead of leaving it to emerge. Equal weighting is what
# let velocity -- always the worst-scoring channel -- capture ~40% of the gradient through the
# worst-case term and steer three searches away from the metrics that matter.
METRIC_WEIGHT = {"trans_xy": 3.0, "yaw": 3.0, "trans_z": 1.0, "tilt": 1.0,
                 "vel_xy": 0.75, "vel_z": 0.40}
HARD_REGRESSION_PENALTY = 2.0    # extra weight on ln(ratio) when a metric is above parity
WORST_WEIGHT = 0.15              # catches divergence without dictating the ranking
WORST_BETA = 6.0
# Breadth: winning 12 datasets narrowly is worth more than winning 6 hugely, which a pure
# log-ratio mean cannot express.
LOSS_PENALTY = 0.60
# Slippage: geomean(ratio on slippage runs) / geomean(ratio on nominal runs). Both are
# Kinetics/RI-EKF, so the KO's own degradation cancels and the quotient is exactly how much more
# it degrades than the RI-EKF does -- below 1 means it degrades *less*. Scored two-sided, like a
# metric: improvement below parity is rewarded, so the search pursues real robustness instead of
# stopping the moment it stops being worse than the baseline.
# 2.0, not 0.5. Slippage robustness is the third stated criterion, and at 0.5 against six weighted
# metrics and two barriers it was a rounding error in the ranking: 18 of 829 full evaluations
# degrade less than the RI-EKF on both slip metrics, and none of those is also accurate, because
# nothing ever optimised for it. It is not structurally opposed to accuracy -- the rank correlation
# is -0.08 for trans_xy and -0.15 for yaw -- so it is weighted, not floored: a third hard barrier
# that nothing satisfies would saturate every trial and leave the sampler no gradient.
SLIP_WEIGHT = 2.00
SLIP_TARGET = 0.90
SLIP_METRICS = ("trans_xy", "yaw")
# Score for a trial that could not be evaluated at all. It has to sit above anything a real
# configuration can score or the sampler would chase failures: with the weighted objective the
# worst genuine trials reach roughly +21, so this is comfortably clear of them.
FAILURE_OBJECTIVE = 50.0
# Hard ceilings: these may not end up more than 10% worse than the RI-EKF. Expressed as a steep
# one-sided barrier on the metric's geomean rather than a rejection, so a violating trial still
# reports a gradient back toward the feasible region instead of a flat failure score. The
# installed tuning already breaches both velocity caps (1.345 and 1.298), so the search starts
# infeasible and has to climb out.
# Velocity and tilt may not end up more than 15% worse than the RI-EKF; the vertical translation
# has to stay at least comparable to it. Best ever seen without the contact-model dimensions:
# vel_xy 1.219, vel_z 1.081, tilt 0.967, trans_z 0.947 -- so only vel_xy starts out of reach, and
# the contact model has never been searched jointly, which is where the velocity lever turned out
# to be (raising HRP5P's normal stiffness half a decade moved vel_z 23% on its own).
# vel_z carries no ceiling: it is the metric the user ranks lowest, and capping it was
# forcing the ranking to reject configurations that won on yaw and translation.
METRIC_CAP = {"vel_xy": 1.10, "tilt": 1.10, "trans_z": 1.05}
# 1.0, not 3.0. No configuration in 1165 evaluations satisfies the vel_xy ceiling, so the
# barrier is charged against every candidate; at 3.0 its gradient dominated the weighted
# terms and picked a configuration 25% worse on yaw to buy vertical translation it did
# not need. At 1.0 the caps act as strong preferences and the weighted priorities decide.
CAP_BARRIER = 1.0

# Beating the RI-EKF on yaw is a requirement, not something to maximise, and a weight cannot say
# that: with trans_xy and yaw weighted equally the optimiser correctly prefers a 32% translation
# gain over a 6% yaw gain, and returns configurations that lose on yaw outright. 111 of 829 full
# evaluations already satisfied yaw <= 1.0 and the ranking never surfaced one. The floor is charged
# steeply enough that no weighted gain buys its way past it.
# Beating the RI-EKF by 5% on yaw. 0.90 was tried first and is outside everything ever observed
# (the record is 0.928); 0.95 sits just inside it, so the target is demanding but not unreached.
# The slippage margin stays at 10% -- seven full evaluations already clear that on both metrics.
REQUIRED = {"yaw": 0.95}
REQUIRED_BARRIER = 8.0
REQUIRED_CLIFF = 1.0
NOMINAL_RUNS = tuple(f"KO_TRO2024_RHPS1_{i}" for i in range(1, 6))
SLIPPAGE_RUNS = tuple(f"KO_TRO_2024_RHPS1_SLIPPAGE_{i}" for i in range(1, 4))

# name -> (covariance field, axis indices, low log10, high log10)
# Bounds bracket the installed value by a few decades; every base point is inside its box.
SPACE = (
    # Round 2. Dimensions the first search converged on are narrowed to a few decades around the
    # value it found, to buy sampling density; the ones that drive the linear velocity error --
    # state_linear_velocity_process and the unmodeled wrench -- are deliberately left at full
    # width, because velocity is the metric that did not move and narrowing it would lock that in.
    # Narrowed to the cell where accuracy and slip robustness coexist. Across 1133 full
    # evaluations, no-slip accuracy is flat from 1e-9 to 1e-6 -- the rest pose can be given
    # three decades of extra freedom for free, because with no slip the visco-elastic
    # relation holds and the measurement pins it anyway -- and 1e-6 is where slip
    # robustness lives. Only 37 of those 1133 points landed here.
    ("contact_process_position_xy", "contact_process", (0, 1), -7.0, -5.5),
    # The installed value is exactly 0, which pins the contact roll and pitch: with no process
    # covariance the filter cannot correct them. They are observable, so there is something to
    # correct, and every strong configuration found so far raises this by six to seven decades --
    # the search arriving at that independently is the clearest evidence the published 0 is wrong.
    # The seed starts at the floor rather than reproducing the 0, so the baseline the search is
    # measured against is the published behaviour.
    ("contact_process_orientation_rp", "contact_process", (3, 4), -12.0, -3.0),
    ("contact_process_orientation_yaw", "contact_process", (5,), -9.0, -4.0),
    ("contact_process_force", "contact_process", (6, 7, 8), 2.0, 5.0),
    ("contact_process_torque", "contact_process", (9, 10, 11), 1.5, 4.5),
    # Split tangential from normal, as the contact process covariances already are. A newly set
    # contact is not equally uncertain in every direction: its height is fixed by the foot
    # touching the ground, while where it lands in the plane is not. Likewise its roll and pitch
    # are pinned by the surface, its yaw is not.
    ("contact_new_position_xy", "contact_initial_new", (0, 1), -7.0, -3.0),
    ("contact_new_position_z", "contact_initial_new", (2,), -7.0, -3.0),
    ("contact_new_orientation_rp", "contact_initial_new", (3, 4), -7.5, -3.5),
    ("contact_new_orientation_yaw", "contact_initial_new", (5,), -7.5, -3.5),
    # These four absorb the error of the *dynamic model*, not the integrator. The acceleration is
    # predicted from the contact wrenches, the inertia and the unmodeled wrench, then integrated
    # second-order in the local frame (v*dt + a*dt^2/2, SE3_integration), so discretisation is
    # O(dt^3) in jerk -- 6e-15 to 3e-12 across these datasets, far below anything that matters.
    # What matters is model error: a prediction wrong by da injects (1/2)da*dt^2 into position and
    # da*dt into velocity every step, and Q is added unscaled per step. For da of 0.2-5 m/s^2 --
    # the range contact-wrench and inertia error plausibly cover -- that is 6e-12..4e-09 on
    # position and 1e-06..6e-04 on velocity. The published velocity value of 1e-10 implies the
    # model predicts acceleration to 0.005 m/s^2, which is not credible, and the search
    # consistently raises it by two decades.
    ("state_position_process", "state_position_process", (0, 1, 2), -13.0, -8.0),
    # Split roll/pitch from yaw. They are not equivalent directions: roll and pitch are observable
    # through gravity in the accelerometer, yaw is not. One isotropic value forces a single
    # compromise across an observable and an unobservable axis -- and yaw is the metric that no
    # configuration improved in ~1400 evaluations, while the contact model (which was split) moved
    # everything else. The largest yaw correlation of any of the 16 flexibility dimensions was
    # +0.23, so the leverage on yaw is not in the contact model; it should be here.
    ("state_orientation_process", "state_orientation_process", (0, 1, 2), -15.0, -8.0),
    # Left wide on purpose: the velocity lever.
    ("state_linear_velocity_process", "state_linear_velocity_process", (0, 1, 2), -14.0, -4.0),
    # Ceiling raised four decades: da of 5 rad/s^2 over a 2 ms step is already 1e-4 of variance,
    # so the old 1e-8 cut off the whole plausible region for a metric (yaw) that never improved.
    ("state_angular_velocity_process", "state_angular_velocity_process", (0, 1, 2), -14.0, -4.0),
    ("gyro_bias_process", "gyro_bias_process", (0, 1, 2), -20.0, -15.0),
    # Left wide on purpose: the unmodeled wrench absorbs what the contact model cannot explain,
    # and it is the other state that feeds the velocity estimate.
    ("unmodeled_force_process", "unmodeled_wrench_process", (0, 1, 2), -4.0, 2.0),
    # Same split: the yaw component of an unmodeled torque is a ground friction moment, the
    # roll/pitch components are compliance. Different physics, so they get different freedom.
    ("unmodeled_torque_process_rp", "unmodeled_wrench_process", (3, 4), -3.0, 3.0),
    ("unmodeled_torque_process_yaw", "unmodeled_wrench_process", (5,), -3.0, 3.0),
    # The gyro bias is the only state that can absorb a yaw-rate error, and the RI-EKF leaves its
    # z component untouched because that direction is unobservable. Letting the search drive this
    # initial variance towards zero recovers the same protection. The axes are split because the
    # horizontal pair trades against tilt while z trades against yaw.
    ("gyro_bias_initial_xy", "gyro_bias_initial", (0, 1), -14.0, -6.0),
    ("gyro_bias_initial_z", "gyro_bias_initial", (2,), -20.0, -6.0),
)

# Axes expressed as a ratio to another axis of the same field, rather than as an absolute
# variance of their own. A Kalman gain depends on the ratio between covariances, not on either
# alone, so a pair of absolute axes mixes two effects into every move: "trust contacts more or
# less overall" and "treat the vertical differently from the horizontal". Splitting them into a
# level and a ratio makes each coordinate mean one thing, which is what the sampler's marginals
# can actually represent -- and it keeps the reachable set identical.
# Same (name, field, axes, low, high) shape as every other space so the samplers can treat them
# uniformly; RATIO_REFERENCE says which axis each one is a multiple of.
# Only the contact position pair qualifies: both axes are non-zero, so their ratio is meaningful.
# The orientation pair does not -- roll/pitch is installed at exactly 0, and a ratio to zero says
# nothing -- so contact_process_orientation_yaw stays an absolute axis.
# Bounded at 1x: the vertical contact process noise may be made tighter than the horizontal but
# never looser. Round 2's screening winner set this to 2.7x -- 27x the installed 0.1 -- which
# looked like a 4% cost on the five screening datasets and doubled trans_z across all thirteen.
RATIO_SPACE = (
    ("contact_process_position_z_ratio", "contact_process", (2,), -3.0, 0.0),
)
RATIO_REFERENCE = {"contact_process_position_z_ratio": ("contact_process", 0)}

# Covariances that legitimately differ between robots because they carry that robot's sensor
# calibration. Searching them as absolute variances would force one robot onto the other's
# calibration, so they are searched as a shared multiplier on each robot's own value instead.
# The moment axes are split because the contact wrench model is far weaker about the foot yaw
# torque, which is a ground friction moment, than about roll and pitch, which really are compliance.
SCALE_SPACE = (
    # Same cell. 1e2 gives the best no-slip accuracy in the whole dataset (0.86 median);
    # the slip-robust configurations sat a decade further out at 1e3, where accuracy falls
    # back to 1.06 -- their poor accuracy was that overshoot, not the price of robustness.
    ("contact_wrench_force_scale", "contact_wrench", (0, 1, 2), 1.0, 3.0),
    ("contact_wrench_moment_xy_scale", "contact_wrench", (3, 4), -2.0, 5.0),
    ("contact_wrench_moment_z_scale", "contact_wrench", (5,), -2.0, 6.0),
    # The two IMU noise covariances are calibrated per robot and differ by ~64x on the gyroscope,
    # so they are scaled rather than shared. The gyroscope is what carries yaw between contacts.
    ("gyroscope_scale", "gyroscope", (0, 1, 2), -3.0, 2.0),
    ("accelerometer_scale", "accelerometer", (0, 1, 2), -3.0, 2.0),
)

# The visco-elastic contact model, per robot and split tangential/normal.
#
# Both robots are searched, and the published values are a weak prior rather than evidence: the
# configs' own comment history shows RHPS1's angular stiffness (727) is HRP2's number verbatim,
# `angDamping: 17` is identical on all six robots in the tree, and `linDamping: 150` is shared by
# RHPS1, HRP5P and JVRC1. None of it was identified per robot. RHPS1's angular stiffness is also
# 4.7x what its own foot geometry predicts (k*L^2/12 ~ 156 N.m/rad), and the ablation independently
# pushed it down to ~200.
#
# The axes are split because the two directions do different jobs -- the normal direction carries
# load, the tangential plane is where a foot slides -- so tying them together is what stops the
# search stiffening against slip without also stiffening everything else.
#
# Stiffness bounds are absolute and physical. At half body weight (~466 N for HRP5P):
#   linear  1e4 .. 1e6 N/m      -> 47 mm .. 0.47 mm of sole deflection
#   angular 1e1 .. 1e5 N.m/rad  -> brackets both the published 727-1000 and the geometric ~156
#
# DAMPING IS BOUNDED BY DAMPING RATIO, NOT BY AN ABSOLUTE VALUE. The same c means very different
# things on the two robots -- RHPS1 is 10x softer and lighter, so its critical damping is 2645
# N.s/m against HRP5P's 10675. A shared absolute ceiling of 1e4 (which is what this used to be)
# allowed zeta = 3.78 on RHPS1: overdamped by a factor of four, which is not a compliant sole but
# a numerical low-pass wearing a physical parameter's name. Rubber's loss factor puts a real sole
# near zeta 0.05-0.1; 0.3 is the most that can still be called sole compliance once ankle
# structural damping is allowed for. The published values sit at zeta 0.01 (HRP5P) and 0.06
# (RHPS1) -- lightly damped, so there is room to move up as well as down.
# Damping is searched as a DAMPING RATIO, not as an absolute value, and the absolute N.s/m is
# derived from whatever stiffness the same trial chose. Anchoring it to a fixed critical damping
# would be wrong twice over: the same c is a different ratio on each robot (RHPS1's critical
# damping is 2645 N.s/m against HRP5P's 10675), and the search moves stiffness too, so a bound
# computed from the published stiffness stops meaning anything once stiffness changes. Searching
# the ratio makes every sampled point physically interpretable by construction.
#
# Rubber's loss factor puts a real sole near zeta 0.05-0.1; 0.3 is the most that can still be
# called sole compliance once ankle structural damping is allowed for. The published values sit at
# zeta 0.057 (RHPS1) and 0.014 (HRP5P), so there is room to move up as well as down.
ZETA_RANGE = (0.005, 0.30)
ROBOT_MASS = {"rhps1": 58.32, "hrp5_p": 94.97}
# The contact's angular spring resists the *body* rotating about the foot, not the foot rotating
# about itself, so the inertia that matters is m*h^2 about the contact with h the CoM height --
# not the foot's own m*L^2/12, which is two orders of magnitude smaller and would put the
# published angular damping at zeta 0.4-0.6 instead of the 0.03-0.05 it actually is.
COM_HEIGHT = 0.80                       # m, both robots standing; only enters as h^2

def critical_damping(robot, stiffness, angular):
    """2*sqrt(k*m) for the linear mode, 2*sqrt(k_ang*m*h^2) for the rotational one."""
    inertia = ROBOT_MASS[robot] * (COM_HEIGHT ** 2 if angular else 1.0)
    return 2.0 * math.sqrt(max(stiffness, 1e-30) * inertia)

# name -> (robot, contact_model field it damps, axes, low, high) in log10 of the *ratio*.
DAMPING_SPACE = tuple(
    (f"{robot}_{'angular' if angular else 'linear'}_damping_ratio_{group}", robot,
     f"{'angular' if angular else 'linear'}_damping", axes,
     math.log10(ZETA_RANGE[0]), math.log10(ZETA_RANGE[1]))
    for robot in ("rhps1", "hrp5_p")
    for angular in (False, True)
    for group, axes in (("xy", (0, 1)), ("z", (2,))))
# the stiffness whose critical damping each ratio is measured against
DAMPING_STIFFNESS = {name: ("angular_stiffness" if "angular" in name else "linear_stiffness")
                     for name, *_ in DAMPING_SPACE}

FLEXIBILITY_STIFFNESS = (("linear_stiffness", 4.0, 6.0), ("angular_stiffness", 1.0, 5.0))
# every contact_model field the overlay may touch, stiffnesses and dampings alike
CONTACT_MODEL_FIELDS = ("linear_stiffness", "angular_stiffness",
                        "linear_damping", "angular_damping")
FLEXIBILITY_ROBOTS = ("rhps1", "hrp5_p")
FLEXIBILITY_SPACE = tuple(
    (f"{robot}_{field}_{group}", robot, field, axes, low, high)
    for robot in FLEXIBILITY_ROBOTS
    for field, low, high in FLEXIBILITY_STIFFNESS
    for group, axes in (("xy", (0, 1)), ("z", (2,)))) + DAMPING_SPACE

ALL_SPACE = SPACE + RATIO_SPACE + SCALE_SPACE + FLEXIBILITY_SPACE

# Noise covariances of sensors the RI-EKF also consumes. Retuning the KO's trust in the gyroscope
# or the accelerometer while the baseline keeps its own is not a like-for-like comparison, so they
# are held at the installed calibration unless --tune-imu-noise says otherwise. The contact wrench
# is not in this list: the RI-EKF uses the force sensors only for contact detection, never in its
# dynamics, so scaling that trust changes nothing on the baseline side.
SHARED_WITH_RIEKF = ("gyroscope_scale", "accelerometer_scale")

# Sensor noise covariances: measured calibration, not free parameters. They are excluded for two
# independent reasons. They describe the hardware, so moving them is a calibration change rather
# than a tuning choice; and `apply_to_mc_rtc` cannot express them -- writing them into the
# per-robot observer file makes the logged covariance stop matching the configured one transported,
# so bin_to_rosbag_kinetics.py drops the transport and silently falls back to the logged values.
# A win found here would therefore evaluate well and then not survive being installed.
# Excluded only because `apply_to_mc_rtc` cannot write them back: putting them in the per-robot
# observer file makes the logged covariance stop matching the configured one, so the converter
# drops the transport and falls back to the logged values. That is an installability limit, not a
# fairness one -- the RI-EKF uses the force sensors only for contact detection, never in its
# dynamics, so scaling this trust does not move the baseline at all. Round 2 searches them anyway,
# because the contact wrench is the one measurement that feeds the velocity state: installing a
# win here costs a re-prepare of the datasets, which is worth knowing about before paying for it.
SENSOR_CALIBRATION = ()

# Dimensions with no measured effect, excluded so the sampler's budget goes where the leverage is.
# Each was moved one at a time from the installed configuration and produced no change:
#   the four flexibility dampings   -- |r| < 0.22 across 264 search trials, both robots
#   contact_process orientation     -- rp and yaw both flat to 4 decimals over +-2 decades
#   contact_process_position_z_ratio-- flat over +-2 decades
#   contact_new_orientation_rp      -- flat; only the yaw half of that pair does anything
# The centroid pose and velocity process covariances ablated flat too, but they stay in the search:
# they are the states the thesis argues about, and one-at-a-time inertness does not rule out an
# effect once the contact terms move with them. They are searched as one variance per family --
# the process model is isotropic in each, and every published config sets them as equal triples.
# Keeping them costs trials: 273 trials over 41 dimensions never beat a recycled seed, while the
# ablations that found all of the above took twenty minutes each.
MEASURED_INERT = (
    "rhps1_linear_damping_ratio_xy", "rhps1_linear_damping_ratio_z",
    "rhps1_angular_damping_ratio_xy", "rhps1_angular_damping_ratio_z",
    "hrp5_p_linear_damping_ratio_xy", "hrp5_p_linear_damping_ratio_z",
    "hrp5_p_angular_damping_ratio_xy", "hrp5_p_angular_damping_ratio_z",
    "contact_process_orientation_rp", "contact_process_orientation_yaw",
    "contact_process_position_z_ratio", "contact_new_orientation_rp",
)

def active_space(tune_imu_noise, only=()):
    """The dimensions actually searched. `only` restricts to a named subset, for focused studies."""
    excluded = set(SENSOR_CALIBRATION) | set(MEASURED_INERT)
    if not tune_imu_noise:
        excluded |= set(SHARED_WITH_RIEKF)
    space = tuple(entry for entry in ALL_SPACE if entry[0] not in excluded)
    if not only:
        return space
    unknown = set(only) - {name for name, *_ in space}
    if unknown:
        raise ValueError(f"--only names dimensions that are not searchable: {', '.join(sorted(unknown))}")
    return tuple(entry for entry in space if entry[0] in set(only))

# Extra starting points found by direct ablation, seeded so the search begins from what is
# already known to work rather than rediscovering it.
SEED_OVERRIDES = (
    {"gyro_bias_initial_xy": -12.0, "gyro_bias_initial_z": -12.0, "gyroscope_scale": -1.0},
    {"gyro_bias_initial_xy": -12.0, "gyro_bias_initial_z": -12.0},
    {"gyroscope_scale": -1.0},
)

# ROS covariance field (with axis slice) -> mc_rtc ekfStateProcessVariances key.
MC_RTC_KEYS = (
    ("state_position_process", slice(0, 3), "statePositionProcessVariance"),
    ("state_orientation_process", slice(0, 3), "stateOriProcessVariance"),
    ("state_linear_velocity_process", slice(0, 3), "stateLinVelProcessVariance"),
    ("state_angular_velocity_process", slice(0, 3), "stateAngVelProcessVariance"),
    ("gyro_bias_process", slice(0, 3), "gyroBiasProcessVariance"),
    ("unmodeled_wrench_process", slice(0, 3), "unmodeledForceProcessVariance"),
    ("unmodeled_wrench_process", slice(3, 6), "unmodeledTorqueProcessVariance"),
    ("contact_process", slice(0, 3), "contactPositionProcessVariance"),
    ("contact_process", slice(3, 6), "contactOrientationProcessVariance"),
    ("contact_process", slice(6, 9), "contactForceProcessVariance"),
    ("contact_process", slice(9, 12), "contactTorqueProcessVariance"),
    ("contact_initial_new", slice(0, 3), "contactPositionInitVarianceNewContacts"),
    ("contact_initial_new", slice(3, 6), "contactOriInitVarianceNewContacts"),
    ("contact_initial_new", slice(6, 9), "contactForceInitVarianceNewContacts"),
    ("contact_initial_new", slice(9, 12), "contactTorqueInitVarianceNewContacts"),
    ("gyro_bias_initial", slice(0, 3), "gyroBiasInitVariance"),
)

PRINT_LOCK = threading.Lock()


def say(message):
    with PRINT_LOCK:
        print(message, flush=True)


def base_covariances():
    """The absolute covariances resolved from mc_rtc, plus the widths of the scaled ones.

    Absolute fields must agree across robots or a single overlay cannot represent them; scaled
    fields are free to differ, which is the whole reason they are scaled.
    """
    fields = sorted({field for _, field, *_ in SPACE} | {field for _, field, *_ in RATIO_SPACE})
    widths = {}
    base = None
    flexibility = {}
    for name in PROJECTS:
        path = project_paths(name)[1] / "resolved_config.yaml"
        if not path.exists():
            raise FileNotFoundError(f"{path}; run kinetics_eval.py prepare first")
        values_all = yaml.safe_load(path.read_text(encoding="utf-8"))
        values = values_all["covariances"]
        current = {field: [float(value) for value in values[field]] for field in fields}
        for _, field, *_ in SCALE_SPACE:
            if field not in values:
                raise RuntimeError(f"{path}: no covariances.{field}")
            if widths.setdefault(field, len(values[field])) != len(values[field]):
                raise RuntimeError(f"covariances.{field} has a different width between robots")
        if base is None:
            base = current
        elif current != base:
            raise RuntimeError("the tunable covariances differ between robots; they must be shared")
        robot = observer_robot(project_robot(project_paths(name)[0]))
        if robot in FLEXIBILITY_ROBOTS and robot not in flexibility:
            model = values_all.get("contact_model")
            if not isinstance(model, dict):
                raise RuntimeError(f"{path}: no contact_model to search the flexibility of")
            flexibility[robot] = {field: [float(v) for v in model[field]]
                                  for field in CONTACT_MODEL_FIELDS if field in model}
    return base, widths, flexibility


def base_point(base, flexibility=None):
    """The installed tuning expressed in the search space, for seeding the study."""
    point = {}
    for name, field, indices, low, high in SPACE:
        value = max(base[field][indices[0]], 1e-30)
        point[name] = min(high, max(low, math.log10(value)))
    for name, field, indices, low, high in RATIO_SPACE:
        reference_field, reference_index = RATIO_REFERENCE[name]
        ratio = base[field][indices[0]] / max(base[reference_field][reference_index], 1e-300)
        point[name] = min(high, max(low, math.log10(max(ratio, 1e-30))))
    for name, _, _, low, high in SCALE_SPACE:
        point[name] = min(high, max(low, 0.0))  # the installed tuning is scale 1
    for name, robot, field, axes, low, high in FLEXIBILITY_SPACE:
        model = (flexibility or {}).get(robot, {})
        if field not in model:
            continue
        value = model[field][axes[0]]
        if name in DAMPING_STIFFNESS:
            # the published damping, expressed as the ratio it is at the published stiffness
            stiffness = model[DAMPING_STIFFNESS[name]][axes[0]]
            value /= critical_damping(robot, stiffness, "angular" in field)
        point[name] = min(high, max(low, math.log10(max(value, 1e-30))))
    return point


def overlay_from(base, widths, point, flexibility=None):
    """The overlay describing a search point: absolute fields, multipliers and per-robot flexibility."""
    values = {field: list(numbers) for field, numbers in base.items()}
    for name, field, indices, _, _ in SPACE:
        if name not in point:
            continue        # not searched (see --only): keep the installed value already in `values`
        for index in indices:
            values[field][index] = 10.0 ** float(point[name])
    # Ratio axes are resolved after the absolute ones, since each is a multiple of an axis the
    # loop above has just written. Left out of the point, a ratio keeps the installed proportion.
    for name, field, indices, _, _ in RATIO_SPACE:
        reference_field, reference_index = RATIO_REFERENCE[name]
        reference = values[reference_field][reference_index]
        ratio = (10.0 ** float(point[name]) if name in point
                 else base[field][indices[0]] / max(base[reference_field][reference_index], 1e-300))
        for index in indices:
            values[field][index] = reference * ratio
    scales = {field: [1.0] * width for field, width in widths.items()}
    for name, field, indices, _, _ in SCALE_SPACE:
        for index in indices:
            # A field the active space leaves out stays at the installed calibration, scale 1.
            scales[field][index] = 10.0 ** float(point.get(name, 0.0))
    overlay = {"covariances": values}
    if scales:
        overlay["covariance_scales"] = scales
    # The visco-elastic model is per-robot, so it rides in its own layer: writing it at the top
    # level would push HRP5P's feet onto RHPS1's stiffness.
    per_robot = {}
    for name, robot, field, axes, _, _ in FLEXIBILITY_SPACE:
        if name in DAMPING_STIFFNESS:
            continue                    # resolved below, once its stiffness is known
        installed = (flexibility or {}).get(robot, {}).get(field)
        if name not in point or installed is None:
            continue
        model = per_robot.setdefault(robot, {}).setdefault(field, list(installed))
        for index in axes:
            model[index] = 10.0 ** float(point[name])
    # Damping last: the ratio is against the critical damping of the stiffness *this trial* uses,
    # so a trial that stiffens the contact gets proportionally more damping for the same ratio.
    for name, robot, field, axes, _, _ in DAMPING_SPACE:
        installed = (flexibility or {}).get(robot, {}).get(field)
        if name not in point or installed is None:
            continue
        stiffness_field = DAMPING_STIFFNESS[name]
        stiffness = per_robot.get(robot, {}).get(stiffness_field)
        if stiffness is None:
            stiffness = (flexibility or {}).get(robot, {}).get(stiffness_field, [1.0])
        model = per_robot.setdefault(robot, {}).setdefault(field, list(installed))
        for index in axes:
            reference = critical_damping(robot, stiffness[index], "angular" in field)
            model[index] = (10.0 ** float(point[name])) * reference
    if per_robot:
        overlay["per_robot"] = {robot: {"contact_model": model} for robot, model in per_robot.items()}
    return overlay


def metric_of(case):
    """The metric name out of a `project|metric` case key."""
    return case.split("|", 1)[1]


def geomean(values):
    return math.exp(sum(math.log(max(v, 1e-9)) for v in values) / len(values))


def slippage_penalty(ratios):
    """Cost of degrading more than the RI-EKF does when the feet slip; zero when it degrades less."""
    by_project = collections.defaultdict(dict)
    for case, value in ratios.items():
        project, metric = case.split("|", 1)
        by_project[project][metric] = value
    reference = riekf_reference()
    total = 0.0
    for metric in SLIP_METRICS:
        # Actual errors, not ratios: the degradation each estimator suffers is a statement about
        # its own error growing, so it is computed from errors and only then compared. Ratios
        # would answer the same question but weight the datasets differently, and the reported
        # tables are in errors -- the objective has to optimise the number that gets published.
        def errors(projects, estimator):
            out = []
            for project in projects:
                base = reference.get(project, {}).get(metric)
                if base is None or metric not in by_project.get(project, {}):
                    continue
                out.append(base if estimator == "riekf" else base * by_project[project][metric])
            return out
        ours = errors(NOMINAL_RUNS, "ko"), errors(SLIPPAGE_RUNS, "ko")
        theirs = errors(NOMINAL_RUNS, "riekf"), errors(SLIPPAGE_RUNS, "riekf")
        if not all(ours + theirs):
            continue
        mean = lambda v: sum(v) / len(v)
        degradation = (mean(ours[1]) / mean(ours[0])) / (mean(theirs[1]) / mean(theirs[0]))
        # Same 10% margin as the yaw floor: degrading merely as little as the RI-EKF is not the
        # criterion, degrading 10% less is. Seven of 829 full evaluations already clear this on
        # both metrics, so unlike the yaw target it is known to be reachable -- just never yet
        # together with nominal accuracy.
        log = math.log(max(degradation, 1e-9) / SLIP_TARGET)
        if log > 0.0:
            # Degrading more than the RI-EKF on this metric is a failure on its own terms. Summing
            # signed logs let a configuration pay for an 8% translation degradation with a 21% yaw
            # improvement and come out at zero -- which is how the anchor scored -0.012 while
            # failing the criterion. Each metric is charged separately, with the same cliff the
            # yaw floor uses, so neither can be traded against the other.
            total += REQUIRED_CLIFF + log + HARD_REGRESSION_PENALTY * log
        else:
            # Credit for genuine robustness. It keeps paying all the way down rather than
            # flattening at the target, so the search has a reason to go past 0.90 instead of
            # parking on it; the bound only stops one metric's robustness from cancelling the
            # other's cliff, which costs 1.0 before its slope even starts.
            total += max(log, -0.60)
    return total


_RIEKF_REFERENCE = {}


def riekf_reference():
    """RI-EKF error per dataset and metric, read once from the installed tuning's evaluation."""
    if not _RIEKF_REFERENCE:
        path = ROOT / "scripts/.ko_cache.json"
        if not path.exists():
            raise RuntimeError(f"{path} is missing; run scripts/ko.py status once to build it")
        _RIEKF_REFERENCE.update(json.loads(path.read_text())["riekf"])
    return _RIEKF_REFERENCE


def objective(ratios):
    """Weighted cost; lower is better, 0 == parity with the RI-EKF on every weighted metric.

    Four terms: a weighted mean of log-ratios that carries the priority; a soft worst case that
    only catches divergence; a penalty on the *number* of datasets lost, so breadth counts; and
    the slippage term. A metric above parity is charged again, so nothing can be traded away.
    """
    costs, weights = [], []
    for case, value in ratios.items():
        weight = METRIC_WEIGHT.get(metric_of(case), 1.0)
        log = math.log(max(value, 1e-9))
        costs.append(weight * (log + HARD_REGRESSION_PENALTY * max(0.0, log)))
        weights.append(weight)
    if not costs:
        raise ValueError("no cases to score")
    total = sum(weights)
    mean = sum(costs) / total
    soft_worst = math.log(sum(math.exp(WORST_BETA * c / w) for c, w in zip(costs, weights))
                          / len(costs)) / WORST_BETA
    lost = sum(w for c, w in zip(costs, weights) if c > 0) / total
    return ((1.0 - WORST_WEIGHT) * mean + WORST_WEIGHT * soft_worst
            + LOSS_PENALTY * lost + SLIP_WEIGHT * slippage_penalty(ratios)
            + CAP_BARRIER * cap_violation(ratios)
            + REQUIRED_BARRIER * requirement_violation(ratios))


def requirement_violation(ratios):
    """How far the required metrics sit above their floor, in log units. Zero when all are met."""
    per = collections.defaultdict(list)
    for case, value in ratios.items():
        per[metric_of(case)].append(value)
    total = 0.0
    for metric, floor in REQUIRED.items():
        if metric not in per:
            continue
        excess = math.log(geomean(per[metric]) / floor)
        if excess > 0.0:
            # A fixed cliff on top of the slope. Proportional-only made a 1.7% violation cost
            # almost nothing, so fifteen of the top twenty configurations sat just above parity:
            # the floor excluded yaw at 1.28 and cheerfully accepted 1.02. Beating the RI-EKF is
            # a yes/no requirement, so crossing the line has to cost more than any weighted gain
            # can repay, independently of by how little it was crossed.
            total += REQUIRED_CLIFF + excess
    return total


def cap_violation(ratios):
    """How far the capped metrics sit above their ceiling, in log units. Zero when all are inside."""
    per = collections.defaultdict(list)
    for case, value in ratios.items():
        per[metric_of(case)].append(value)
    return sum(max(0.0, math.log(geomean(per[metric]) / cap))
               for metric, cap in METRIC_CAP.items() if metric in per)


def read_ratios(path, projects):
    pairs = collections.defaultdict(dict)
    with path.open(newline="", encoding="utf-8") as stream:
        for row in csv.DictReader(stream):
            if row["statistic"] == "median" and row["metric"] in POSE_METRICS:
                pairs[(row["project"], row["metric"])][row["estimator"]] = float(row["value"])
    expected = len(projects) * len(POSE_METRICS)
    if len(pairs) != expected:
        raise RuntimeError(f"expected {expected} median comparisons in {path}, found {len(pairs)}")
    return {f"{project}|{metric}": values["Kinetics"] / max(values["RI-EKF"], 1e-12)
            for (project, metric), values in pairs.items()}


def estimated_local_velocity(pose, velocity, grid, settings):
    """The Kinetics observer's own velocity state, in the frame projectConfig evaluates.

    v_local = R_fb^-1 . v_fb at the floating base; for an IMU evaluation frame the state is
    transported across the rigid IMU mount, v_local_imu = rImuFb . (v_local_fb + w_local x posFbImu).
    Nothing here differentiates the estimate: it is the observer's estimated velocity.
    """
    import numpy as np
    from scipy.spatial.transform import Rotation, Slerp
    times = velocity[:, 0]
    clamped = np.clip(grid, times[0], times[-1])
    linear = np.column_stack([np.interp(grid, times, velocity[:, 1 + axis]) for axis in range(3)])
    angular = np.column_stack([np.interp(grid, times, velocity[:, 4 + axis]) for axis in range(3)])
    rotation = Slerp(pose[:, 0], Rotation.from_quat(pose[:, 4:8]))(np.clip(grid, pose[0, 0], pose[-1, 0]))
    local = rotation.apply(linear, inverse=True)
    if settings["frame"] != "IMU":
        return local
    angular_local = rotation.apply(angular, inverse=True)
    r_imu_fb = Rotation.from_quat(settings["r_imu_fb"])
    return r_imu_fb.apply(local + np.cross(angular_local, settings["pos_fb_imu"]))


def velocity_errors(estimate, mocap):
    """RMS local linear velocity error, split horizontally and vertically."""
    import numpy as np
    residual = estimate - mocap
    return (float(np.sqrt(np.mean(np.linalg.norm(residual[:, 0:2], axis=1) ** 2))),
            float(np.sqrt(np.mean(residual[:, 2] ** 2))))


def velocity_ratios(directory, projects, reference_cache):
    """RMS local velocity error of Kinetics over that of RI-EKF, per dataset and per axis group."""
    import numpy as np
    ratios = {}
    for name in projects:
        grid, mocap, riekf, settings = reference_cache[name]
        pose = np.loadtxt(directory / name / "kinetics.txt", comments="#", ndmin=2)
        velocity = np.loadtxt(directory / name / "kinetics_velocity.txt", comments="#", ndmin=2)
        local = estimated_local_velocity(pose, velocity, grid, settings)
        errors = velocity_errors(local, mocap)
        for metric, error, baseline in zip(VELOCITY_METRICS, errors, riekf):
            ratios[f"{name}|{metric}"] = error / max(baseline, 1e-12)
    return ratios


def self_consistency(directory, projects):
    """rms(v - dp/dt) / rms(dp/dt) per dataset, from the estimate alone.

    The observer publishes floating-base position and linear velocity as two independent EKF
    states; nothing in the update enforces v = dp/dt, so the gap between them is a property of
    the tuning that needs no ground truth, no mocap and no time alignment to measure. It is a
    diagnostic, NOT an objective: forcing it to zero is trivially achievable by letting the
    velocity chase a noisy position, which makes the mocap-referenced error worse (measured:
    state_linear_velocity_process x1e6 drives HRP5 consistency 0.182 -> 0.069 while the
    velocity ratio degrades 1.221 -> 1.445). Read it alongside the ratio, never instead of it.

    The position is differentiated exactly as the pipeline differentiates mocap, so the two
    sides of the comparison carry the same filter; the half-sample skew of that backward
    difference is common to both and cancels in the ratio.
    """
    import numpy as np
    from kinetics_eval import differentiate
    values = {}
    for name in projects:
        pose = np.loadtxt(directory / name / "kinetics.txt", comments="#", ndmin=2)
        velocity = np.loadtxt(directory / name / "kinetics_velocity.txt", comments="#", ndmin=2)
        times = pose[:, 0]
        step = float(np.median(np.diff(times)))
        # The velocity file is published on the same stamps as the pose, but interpolate rather
        # than assume it, so a future change of publication rate cannot silently misalign them.
        reported = np.column_stack([np.interp(times, velocity[:, 0], velocity[:, 1 + axis])
                                    for axis in range(3)])
        derived = differentiate(pose[:, 1:4], step)
        edge = min(400, len(times) // 4)          # filtfilt transients at both ends
        window = slice(edge, len(times) - edge)
        rms = lambda block: float(np.sqrt(np.mean(np.sum(block ** 2, axis=1))))
        values[f"{name}|consistency"] = rms(reported[window] - derived[window]) / max(rms(derived[window]), 1e-12)
    return values


def reference_velocities(projects):
    """Mocap local velocity and the RI-EKF error, both prepared by kinetics_eval.py."""
    import numpy as np
    cache = {}
    for name in projects:
        _, directory = project_paths(name)
        settings = json.loads((directory / "time_offset.json").read_text(encoding="utf-8"))
        mocap = np.loadtxt(directory / "reference/mocap_velocity.txt", comments="#", ndmin=2)
        riekf = np.loadtxt(directory / "reference/riekf_velocity.txt", comments="#", ndmin=2)
        grid = mocap[:, 0]
        error = velocity_errors(riekf[:, 1:4], mocap[:, 1:4])
        cache[name] = (grid, mocap[:, 1:4], error, settings)
    return cache


# Process groups of the trials currently running. Each trial gets its own session, so killing
# the search's own group does NOT reach them: without this, a Ctrl-C or `kill` on the search
# leaves every in-flight trial's `ros2 bag record` running, writing into a results directory
# nobody will ever read. Twenty-two of those once held 130 GB of deleted files open.
LIVE_GROUPS = set()
# Set once a shutdown signal arrives. Killing the running trials is not enough on its own: the
# worker threads would simply launch the next ones, and SystemExit raised inside a signal handler
# cannot escape a blocked ThreadPoolExecutor. Every trial checks this before spawning, so the
# pool drains instead of refilling.
SHUTTING_DOWN = threading.Event()


def signal_group(group, number):
    """Send `number` to a process group; True if the group still existed. Never raises."""
    try:
        os.killpg(group, number)
        return True
    except (ProcessLookupError, PermissionError, OSError):
        return False


def terminate_live_groups(*_, grace=3.0):
    """Take every running trial down. Bounded by `grace`, not by the number of trials.

    Signals go out to all groups at once and the wait is shared: killing eight trials one at a
    time, each with its own multi-second grace period, takes long enough that a shutdown looks
    like a hang and gets SIGKILLed from outside -- which is exactly how the trials got orphaned.
    """
    groups = list(LIVE_GROUPS)
    for group in groups:
        signal_group(group, signal.SIGTERM)
    deadline = time.time() + grace
    while time.time() < deadline:
        if not any(signal_group(group, 0) for group in groups):
            break
        time.sleep(0.1)
    for group in groups:
        signal_group(group, signal.SIGKILL)
    for group in groups:
        LIVE_GROUPS.discard(group)


def install_shutdown_handlers():
    atexit.register(terminate_live_groups)
    for number in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        def handler(signum, frame):
            # No chaining to the previous handler: Python's default SIGINT handler raises
            # KeyboardInterrupt, which would unwind out of here before the exit below and leave
            # the pool's threads -- and their trials -- running.
            SHUTTING_DOWN.set()          # stop the pool refilling before killing what runs
            terminate_live_groups()
            os._exit(128 + signum)       # the pool's threads are non-daemon; do not wait on them

        signal.signal(number, handler)


def terminate_group(group):
    """Kill the process group `group`, SIGTERM then SIGKILL. Never raises.

    Takes the group id rather than the Popen, because the caller has to be able to run this
    *after* the leader has been reaped: that is precisely when a grandchild is left behind, and
    os.getpgid() of a reaped pid raises. start_new_session=True makes the group id equal the
    child's pid, so the caller can capture it at spawn time and it stays valid for the group.
    """
    for signal_number in (signal.SIGTERM, signal.SIGKILL):
        try:
            os.killpg(group, signal_number)
        except (ProcessLookupError, PermissionError, OSError):
            return
        deadline = time.time() + 5.0
        while time.time() < deadline:
            try:
                os.killpg(group, 0)          # group still has members
            except (ProcessLookupError, OSError):
                return
            time.sleep(0.2)


def run_evaluation(payload, projects, label, domain, workspace, timeout):
    overlay = ROOT / "results" / f".overlay-{label}.yaml"
    overlay.parent.mkdir(parents=True, exist_ok=True)
    overlay.write_text(yaml.safe_dump(payload, sort_keys=False), encoding="utf-8")
    environment = {**os.environ, "ROS_DOMAIN_ID": str(domain)}
    command = [sys.executable, ROOT / "scripts/kinetics_eval.py",
               "--workspace", workspace, "--projects", ",".join(projects),
               "--covariance-overlay", overlay, "run", "--label", label,
               "--no-plots", "--no-latest", "--no-open"]
    if SHUTTING_DOWN.is_set():
        return None, "shutting down"
    # The trial runs in its own process group so that a timeout can take the whole tree down.
    # kinetics_eval.py spawns `ros2 launch`, which spawns the observer and the bag publisher;
    # killing only the direct child leaves those alive, still publishing on this trial's
    # ROS_DOMAIN_ID. Every later trial assigned to the same domain then joins a graph that
    # already has a publisher pumping another dataset's inputs, and the observer rejects the
    # interleaved stream with "input timestamps must increase" until it too times out. One hung
    # trial silently poisons its worker slot for the rest of the search.
    process = subprocess.Popen(list(map(str, command)), cwd=ROOT, text=True, env=environment,
                               stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                               start_new_session=True)
    LIVE_GROUPS.add(process.pid)
    try:
        try:
            output, code = process.communicate(timeout=timeout)[0], process.returncode
        except subprocess.TimeoutExpired:
            terminate_group(process.pid)
            output, code = (process.communicate()[0] or ""), -1
        if isinstance(output, bytes):
            output = output.decode(errors="replace")
    finally:
        # Also on the normal path: a trial that exited cleanly can still have left a stray node
        # behind, and the group is empty by then so this costs nothing.
        terminate_group(process.pid)
        LIVE_GROUPS.discard(process.pid)
        overlay.unlink(missing_ok=True)
    results = sorted((ROOT / "results").glob(f"{label}-*"), key=lambda path: path.stat().st_mtime)
    directory = results[-1] if results else None
    if code or directory is None or not (directory / "summary.csv").exists():
        if directory is not None:
            shutil.rmtree(directory, ignore_errors=True)
        return None, output[-1500:].replace("\n", " ")
    return directory, ""


class Search:
    def __init__(self, args, base, widths, flexibility=None):
        self.anchor = None
        import optuna
        optuna.logging.set_verbosity(optuna.logging.WARNING)
        self.optuna = optuna
        self.args = args
        self.base = base
        self.widths = widths
        self.flexibility = flexibility
        self.space = active_space(getattr(args, "tune_imu_noise", False),
                                  tuple(getattr(args, "only", None) or ()))
        self.tracking = args.tracking
        self.tracking.mkdir(parents=True, exist_ok=True)
        self.ledger = self.tracking / "trials.csv"
        self.counter = 0
        self.velocities = reference_velocities(getattr(args, "dataset_list", None) or PROJECTS)
        self.lock = threading.Lock()
        self.records = []
        if self.ledger.exists():
            with self.ledger.open(newline="", encoding="utf-8") as stream:
                self.records = list(csv.DictReader(stream))
            self.counter = max((int(record["trial"]) for record in self.records), default=-1) + 1

    def study(self, name):
        """The sampler for one phase.

        Screening uses multivariate TPE: it explores a wide box cheaply and tolerates the failed
        trials that a broad space produces. Refinement uses CMA-ES, which adapts a full covariance
        matrix over the search space -- it learns the correlated directions and steps along them,
        which is what the covariances need, since a Kalman gain depends on the ratio between them
        and almost every useful move is diagonal in this parameterisation. TPE only models a joint
        density and, at 22 dimensions with a few hundred trials, is too undersampled to find those
        directions on its own.
        """
        if name == "full" and self.args.refine_sampler == "cmaes":
            return self.optuna.create_study(
                study_name=name, direction="minimize",
                # popsize matched to the worker count. CMA-ES will not emit the next generation
                # until the current one closes, so a population larger than the pool leaves
                # workers idle waiting on the straggler -- measured at 62% utilisation with the
                # default 4+3*ln(36)=14 against 8 workers. One generation per batch costs only
                # the spread in trial duration, which is under 15%.
                # x0 anchors the initial mean on the best known point. Without it Optuna starts
                # CMA-ES at the centre of the domain and ignores the enqueued seeds for its mean,
                # so a refinement run spends its whole budget exploring the middle of the box --
                # measured at median J=4.34 over 64 trials against a seed worth J=1.37. sigma0 is
                # in raw units, and every dimension here is a log10 exponent, so 0.75 means the
                # first generation samples within about a decade of the anchor.
                # popsize is 2x the workers, not 1x: CMA-ES needs at least 4+3*ln(n) samples per
                # generation to estimate a covariance in n dimensions (14 at n=27), and below that
                # step-size control inflates instead of contracting -- measured as nine generations
                # walking from J=1.38 to J=5.41 without a single improvement. Two waves per
                # generation costs one barrier per two waves, which is cheaper than not converging.
                # sigma0 is per-dimension, so the population sits at sqrt(n)*sigma0 from the
                # anchor: 0.5 puts it about two and a half decades away. 0.75 diverged, but that was with
# popsize below the 4+3*ln(n) minimum; at popsize 24 the adaptation is stable and the
# wider spread is what lets the search leave a seeded region rather than polish it.
                sampler=self.optuna.samplers.CmaEsSampler(
                    seed=SEED, popsize=2 * self.args.workers,
                    x0=self.anchor, sigma0=0.25),
                storage=f"sqlite:///{self.tracking / 'study.db'}", load_if_exists=True)
        sampler = self.optuna.samplers.TPESampler(seed=SEED, n_startup_trials=self.args.startup,
                                                  multivariate=True, group=True)
        return self.optuna.create_study(
            study_name=name, direction="minimize", sampler=sampler,
            storage=f"sqlite:///{self.tracking / 'study.db'}", load_if_exists=True)

    def write_ledger(self):
        columns = ("trial", "phase", "status", "objective", "geomean", "worst", "wins", "cases",
                   "seconds", "point", "ratios", "error")
        temporary = self.ledger.with_suffix(".tmp")
        with temporary.open("w", newline="", encoding="utf-8") as stream:
            writer = csv.DictWriter(stream, fieldnames=columns)
            writer.writeheader()
            writer.writerows(self.records)
        temporary.replace(self.ledger)

    def evaluate(self, point, projects, phase, keep=False):
        with self.lock:
            index = self.counter
            self.counter += 1
        domain = self.args.domain_base + (index % self.args.workers)
        label = f"{self.args.prefix}-{phase}-{index:04d}"
        overlay = overlay_from(self.base, self.widths, point, self.flexibility)
        started = time.time()
        directory, error = run_evaluation(overlay, projects, label, domain,
                                          self.args.workspace, self.args.timeout)
        elapsed = time.time() - started
        if directory is None:
            value, ratios = FAILURE_OBJECTIVE, {}
            geomean = worst = float("nan")
            wins = 0
            status = "failed"
        else:
            try:
                ratios = read_ratios(directory / "summary.csv", projects)
                ratios.update(velocity_ratios(directory, projects, self.velocities))
                value = objective(ratios)
                logs = [math.log(max(v, 1e-9)) for v in ratios.values()]
                geomean = math.exp(sum(logs) / len(logs))
                worst = max(ratios.values())
                wins = sum(v < 1.0 for v in ratios.values())
                status = "ok"
                error = ""
            # A corrupt or truncated trial output must cost one trial, not the whole search:
            # velocity_ratios reads trajectories that a killed replay can leave non-monotonic.
            except (RuntimeError, ValueError, OSError, IndexError) as failure:
                value, ratios = FAILURE_OBJECTIVE, {}
                geomean = worst = float("nan")
                wins, status, error = 0, "failed", str(failure)
            if keep and status == "ok":
                shutil.move(str(directory), str(self.tracking / f"best-{phase}"))
            else:
                shutil.rmtree(directory, ignore_errors=True)
        record = {
            "trial": index, "phase": phase, "status": status, "objective": f"{value:.17g}",
            "geomean": f"{geomean:.6g}", "worst": f"{worst:.6g}", "wins": wins,
            "cases": len(ratios), "seconds": f"{elapsed:.1f}",
            "point": json.dumps(point, sort_keys=True, separators=(",", ":")),
            "ratios": json.dumps(ratios, sort_keys=True, separators=(",", ":")),
            "error": error,
        }
        with self.lock:
            self.records.append(record)
            self.write_ledger()
        say(f"  [{phase} {index:04d}] {status} J={value:+.4f} geomean={geomean:.3f} "
            f"worst={worst:.3f} wins={wins}/{len(ratios) or 1} ({elapsed:.0f}s)")
        return value

    def phase(self, name, projects, trials, seeds=()):
        # The sampler is built inside study(); set the CMA-ES anchor before it exists.
        if self.anchor is None and seeds:
            self.anchor = dict(seeds[0])
        study = self.study(name)
        for seed in seeds:
            study.enqueue_trial(seed, skip_if_exists=True)
        remaining = trials - len([t for t in study.trials
                                  if t.state == self.optuna.trial.TrialState.COMPLETE])
        if remaining <= 0:
            return study
        say(f"phase {name}: {remaining} trials on {len(projects)} datasets, "
            f"{self.args.workers} workers")

        def one(index):
            # ask() outside any lock of ours. CMA-ES is generational: when a trial never reports
            # -- a hung replay -- it can stall inside ask() waiting for the generation to close,
            # and holding a shared lock there takes every other worker down with it. Optuna's
            # storage is already safe for concurrent access; our lock is only needed for the
            # ledger. One hung trial then costs one worker, not the pool.
            trial = study.ask({name: self.optuna.distributions.FloatDistribution(low, high)
                               # entries vary in arity (the flexibility ones carry a robot);
                               # bounds are always the last two fields.
                               for name, *_, low, high in self.space})
            # The whole body is guarded, `tell` included. Optuna raises "Cannot tell a COMPLETE
            # trial" if the trial's state was changed underneath us -- which happens when another
            # process writes to the same study, as enqueueing seeds into a live run does. Leaving
            # `tell` outside this guard once cost the run even though `evaluate` was protected.
            try:
                value = self.evaluate(dict(trial.params), projects, name)
                study.tell(trial, value)
            except Exception as failure:                     # noqa: BLE001 - deliberately broad
                say(f"  [{name} {index:04d}] crashed: {type(failure).__name__}: {failure}")
                try:
                    study.tell(trial, FAILURE_OBJECTIVE)
                except Exception:                            # already told, or state is gone
                    pass

        with ThreadPoolExecutor(max_workers=self.args.workers) as pool:
            list(pool.map(one, range(remaining)))
        return study


SPLIT_SUFFIXES = ("_xy", "_z", "_rp", "_yaw")


def seed_value(point, name, default):
    """The value an earlier point used for `name`, following the dimension across renames.

    Dimensions get split (contact_new_position -> _xy/_z) and merged (state_orientation_process_rp
    /_yaw -> one isotropic variance) as the search learns what the model actually has. An older
    point still holds the value it was evaluated at, under the older name, so a plain
    `point.get(name, default)` silently substitutes the default for exactly the dimensions that
    changed -- which corrupts the best points rather than skipping them. Measured: the best point
    ever found re-seeded to J=+4.27 instead of +1.37 because five of its dimensions had been
    renamed that afternoon.
    """
    if name in point:
        return point[name]
    for suffix in SPLIT_SUFFIXES:                      # split since: inherit the parent
        if name.endswith(suffix) and name[:-len(suffix)] in point:
            return point[name[:-len(suffix)]]
    children = [point[name + s] for s in SPLIT_SUFFIXES if name + s in point]
    if children:                                       # merged since: average the halves
        return sum(children) / len(children)
    return default


def recycled_seeds(ledgers, count, searchable, defaults):
    """The best points from earlier runs, ranked by what we are optimising for *now*.

    A changed objective invalidates the recorded scores but not the evaluations behind them: the
    per-dataset ratios are stored, so every past point can be re-scored for free and the good ones
    handed to the new study as starting positions. Points missing a dimension the current space
    searches are skipped -- they would seed it at a value the sampler never chose.
    """
    scored = []
    for ledger in ledgers:
        if not ledger.exists():
            raise FileNotFoundError(ledger)
        for row in csv.DictReader(ledger.open()):
            # Older ledgers predate columns this one relies on; skip rather than fail, so a
            # pooled --seed-from across a project's whole history stays usable.
            if not {"status", "ratios", "point"} <= row.keys():
                continue
            # Partial evaluations are not comparable with full ones: 914 of the project's 1743
            # points were scored on 5, 7 or 12 datasets, and pooling them ranked configurations
            # against each other on different data. Seed only from complete evaluations.
            if row["ratios"].strip() not in ("", "{}") and \
                    len({case.split("|")[0] for case in json.loads(row["ratios"])}) != len(PROJECTS):
                continue
            if row["status"] != "ok" or not (row["ratios"] or "").strip() or \
                    row["ratios"].strip() == "{}" or not (row["point"] or "").strip():
                continue
            point = json.loads(row["point"])
            # A point from before a dimension existed is still worth having: that run simply used
            # the installed value for it, so filling the gap from `defaults` reconstructs exactly
            # the configuration that was evaluated. Requiring every dimension instead silently
            # discarded 238 points -- including the best one ever found -- the moment the contact
            # model became searchable. Values outside the current bounds are clamped, since the
            # bounds have since been tightened to physical ranges.
            filled = {}
            for name, (low, high) in searchable.items():
                filled[name] = min(high, max(low, seed_value(point, name, defaults[name])))
            try:
                scored.append((objective(json.loads(row["ratios"])), filled,
                               json.loads(row["ratios"])))
            except (ValueError, KeyError):
                continue
    scored.sort(key=lambda pair: pair[0])
    # Reserve a third of the slots for the most slip-robust points, whatever their overall rank.
    # The objective's weighted mean is dominated by nominal accuracy, so ranking alone returns
    # twelve neighbours from one region -- the accurate one -- and the sampler never sees the
    # region where slippage robustness lives. Seeding both gives it the span between them.
    if scored and count > 2:
        reserve = max(1, count // 3)
        by_slip = sorted(scored, key=lambda pair: slippage_penalty(pair[2]))
        picked, chosen = [], set()
        for _, point, _ in by_slip[:reserve]:
            key = tuple(sorted(point.items()))
            if key not in chosen:
                chosen.add(key); picked.append(point)
        for _, point, _ in scored:
            if len(picked) >= count: break
            key = tuple(sorted(point.items()))
            if key not in chosen:
                chosen.add(key); picked.append(point)
        say(f"recycled {len(picked)} of {len(scored)} earlier points as seeds "
            f"({reserve} reserved for slippage robustness, best re-scores to J={scored[0][0]:+.4f})")
        return picked
    if scored:
        say(f"recycled {min(count, len(scored))} of {len(scored)} earlier points as seeds "
            f"(best re-scores to J={scored[0][0]:+.4f})")
    return [point for _, point, _ in scored[:count]]


def completed(study, optuna):
    return [trial for trial in study.trials if trial.state == optuna.trial.TrialState.COMPLETE]


def substitute(text, key, values, source):
    """Replace one `key: [...]` list in place, keeping every comment and the surrounding layout."""
    pattern = re.compile(rf"(?m)^(\s*{re.escape(key)}:\s*)\[[^\]]*\](.*)$")
    rendered = "[" + ", ".join(f"{float(value):.12g}" for value in values) + "]"
    text, count = pattern.subn(lambda m: f"{m.group(1)}{rendered}{m.group(2)}", text, count=1)
    if count != 1:
        raise RuntimeError(f"{source}: expected exactly one `{key}: [...]` line, found {count}")
    return text


def apply_to_mc_rtc(covariances, source, destination):
    """Write the winning covariances back into the mc_rtc observer YAML, comments intact."""
    text = source.read_text(encoding="utf-8")
    for field, axes, key in MC_RTC_KEYS:
        text = substitute(text, key, covariances[field][axes], source)
    destination.write_text(text, encoding="utf-8")


def write_report(search, best_point, best_ratios, base_ratios, destination):
    def block(ratios):
        per_metric = collections.defaultdict(list)
        for key, value in ratios.items():
            per_metric[key.split("|")[1]].append(value)
        lines = []
        for metric in METRICS:
            values = per_metric[metric]
            if not values:
                continue
            geomean = math.exp(sum(math.log(max(v, 1e-9)) for v in values) / len(values))
            lines.append(f"| {metric} | {geomean:.3f} | {max(values):.3f} | "
                         f"{sum(v < 1 for v in values)}/{len(values)} |")
        return lines

    lines = [
        "# MCKineticsObserver covariance retuning", "",
        f"- Seed: `{SEED}`  Trials: `{len(search.records)}`  Datasets: `{len(PROJECTS)}`",
        "- Metrics: relative `trans_xy` / `trans_z` / `yaw` / `tilt` medians from rpg, plus "
        "`vel_xy` and `vel_z`, the RMS error of the observer's *estimated* local linear velocity "
        "split by axis group, in the frame each project's `Body_vel_eval` selects.",
        f"- Objective: weighted log-ratios ({', '.join(f'{m} x{w:g}' for m, w in METRIC_WEIGHT.items())}), "
        f"a soft worst case at {WORST_WEIGHT:g}, a {LOSS_PENALTY:g} penalty on the weighted fraction "
        f"of datasets lost, a {SLIP_WEIGHT:g} two-sided slippage term, and a {CAP_BARRIER:g} barrier "
        f"on {', '.join(f'{m}<={c:g}' for m, c in METRIC_CAP.items())}. "
        "Every number below is Kinetics / RI-EKF, so <1 is a win.",
        f"- Objective: `{(1 - WORST_WEIGHT):.1f}*mean(ln r) + {WORST_WEIGHT:.1f}*softmax_"
        f"{WORST_BETA:g}(ln r)`, r = Kinetics median / RI-EKF median. Lower is better; 0 is parity.",
        f"- Baseline objective: `{objective(base_ratios):+.4f}`",
        f"- Tuned objective: `{objective(best_ratios):+.4f}`", "",
        "## Aggregate ratios (Kinetics / RI-EKF, lower is better)", "",
        "| Metric | geomean | worst | wins |", "|---|---:|---:|---:|",
        "| **baseline** | | | |", *block(base_ratios),
        "| **tuned** | | | |", *block(best_ratios), "",
        "## Per-dataset ratios (Kinetics / RI-EKF)", "",
        "| Dataset | " + " | ".join(f"{metric} base | {metric} tuned" for metric in METRICS) + " |",
        "|---" + "|---:" * (2 * len(METRICS)) + "|",
    ]
    for project in PROJECTS:
        cells = []
        for metric in METRICS:
            key = f"{project}|{metric}"
            cells.extend((f"{base_ratios[key]:.3f}", f"{best_ratios[key]:.3f}"))
        lines.append(f"| {project} | " + " | ".join(cells) + " |")
    # A field the active space left out was never searched: report it as held at its installed value.
    def line(name):
        if name not in best_point:
            return f"{name:34}   held (excluded from the search)"
        return f"{name:34} {best_point[name]:+.3f}  ({10 ** best_point[name]:.4g})"

    lines.extend(("", "## Winning point (log10 variance)", "", "```",
                  *(line(name) for name, *_ in ALL_SPACE), "```", "",
                  "## Files", "",
                  "- `best-overlay.yaml`: covariance overlay for `kinetics_eval.py --covariance-overlay`",
                  "- `MCKineticsObserver.yaml`: the mc_rtc observer config with the tuning applied",
                  "- `trials.csv`, `study.db`: every trial and its metrics", ""))
    destination.write_text("\n".join(lines) + "\n", encoding="utf-8")


def main():
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--tracking", type=Path, default=ROOT / "results/kinetics-retuning")
    parser.add_argument("--screen-trials", type=int, default=140)
    parser.add_argument("--full-trials", type=int, default=70)
    parser.add_argument("--promote", type=int, default=12, help="Top phase-A points re-scored in phase B")
    parser.add_argument("--workers", type=int, default=6)
    parser.add_argument("--startup", type=int, default=30, help="Random trials before TPE takes over")
    parser.add_argument("--domain-base", type=int, default=60)
    # Trials take ~1000 s on all thirteen datasets, so 1800 s is generous while capping what a
    # hung replay costs. It used to be 3600.
    parser.add_argument("--timeout", type=int, default=1800)
    parser.add_argument("--tune-imu-noise", action="store_true",
                        help="Also search the gyroscope and accelerometer noise scales. These are "
                             "shared with the RI-EKF baseline, so a win found this way is not "
                             "like-for-like unless the baseline is adjusted to match.")
    parser.add_argument("--only", nargs="+", metavar="DIM",
                        help="Search only these dimensions, holding the rest at the installed "
                             "configuration. For focused studies of one mechanism.")
    parser.add_argument("--refine-sampler", choices=("cmaes", "tpe"), default="cmaes",
                        help="Sampler for the full-dataset phase. CMA-ES adapts a covariance over "
                             "the search space, so it follows the correlated directions the "
                             "covariances actually move along; TPE reproduces the old behaviour.")
    parser.add_argument("--seed-from", type=Path, action="append", default=[],
                        help="A previous trials.csv. Its points are re-scored under the *current* "
                             "objective and the best are enqueued as seeds, so changing the "
                             "criteria costs the sampler's learned state but not the evaluations.")
    parser.add_argument("--seed-count", type=int, default=8)
    parser.add_argument("--datasets",
                        help="Comma-separated subset to score on. The contact-model dimensions are "
                             "per robot, so a study of one robot's flexibility gains nothing from "
                             "replaying the other's datasets -- and pays 13x for them.")
    parser.add_argument("--prefix", default="tune")
    parser.add_argument("--workspace", type=Path, default=Path("/home/arnaud/devel/src/catkin_ws"))
    args = parser.parse_args()
    args.tracking = args.tracking.resolve()
    install_shutdown_handlers()

    datasets = ([p.strip() for p in args.datasets.split(",")] if args.datasets else list(PROJECTS))
    unknown = [p for p in datasets if p not in PROJECTS]
    if unknown:
        raise ValueError(f"unknown datasets: {', '.join(unknown)}")
    base, widths, flexibility = base_covariances()
    start = base_point(base, flexibility)
    args.dataset_list = datasets
    search = Search(args, base, widths, flexibility)
    optuna = search.optuna

    seeds = [start] + [{**start, **override} for override in SEED_OVERRIDES]
    recycled = recycled_seeds(args.seed_from, args.seed_count,
                              {name: (low, high) for name, *_, low, high in search.space}, start)
    # Centre CMA-ES on the best point anyone has found, falling back to the installed tuning when
    # there is no history. seeds[0] is the installed baseline, which is a worse anchor whenever a
    # previous run beat it.
    search.anchor = dict(recycled[0]) if recycled else dict(start)
    seeds += recycled
    if args.screen_trials:
        screen = search.phase("screen", list(SCREEN_PROJECTS), args.screen_trials, seeds=seeds)
        finished = completed(screen, optuna)
        if not finished:
            raise RuntimeError("no successful screening trial")
        ranked = sorted(finished, key=lambda trial: trial.value)
        promoted = [start] + [dict(trial.params) for trial in ranked[:args.promote]]
        say(f"phase screen done: best J={ranked[0].value:+.4f} over {len(finished)} trials; "
            f"promoting {len(promoted)} points")
    else:
        # Screening on a five-dataset subset has now twice produced points that score well there
        # and badly on all thirteen -- trans_z is invisible on short sub-trajectories, so a tuning
        # that wrecks the vertical channel screens clean. With --screen-trials 0 every trial is
        # scored on what actually matters, at roughly ten times the cost per trial.
        promoted = seeds
        say(f"screening skipped: seeding the full phase with {len(promoted)} points")

    full = search.phase("full", datasets, args.full_trials, seeds=promoted)
    finished = completed(full, optuna)
    if not finished:
        raise RuntimeError("no successful full trial")
    winner = min(finished, key=lambda trial: trial.value)
    best_point = dict(winner.params)
    say(f"phase full done: best J={winner.value:+.4f}")

    say("re-running the winner and the baseline on all datasets")
    search.evaluate(best_point, datasets, "best", keep=True)
    search.evaluate(start, datasets, "base", keep=True)
    best_ratios = json.loads(next(r for r in reversed(search.records) if r["phase"] == "best")["ratios"])
    base_ratios = json.loads(next(r for r in reversed(search.records) if r["phase"] == "base")["ratios"])

    overlay = overlay_from(base, widths, best_point, flexibility)
    (args.tracking / "best-overlay.yaml").write_text(
        yaml.safe_dump(overlay, sort_keys=False), encoding="utf-8")
    apply_to_mc_rtc(overlay["covariances"], DEFAULT_MCKINETICS_CONFIG.expanduser(),
                    args.tracking / "MCKineticsObserver.yaml")
    write_report(search, best_point, best_ratios, base_ratios, args.tracking / "report.md")
    say(f"\nreport:  {args.tracking / 'report.md'}")
    say(f"overlay: {args.tracking / 'best-overlay.yaml'}")
    say(f"config:  {args.tracking / 'MCKineticsObserver.yaml'}")


if __name__ == "__main__":
    main()
